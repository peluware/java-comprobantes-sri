<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.peluware.sri</groupId>
    <artifactId>comprobantes-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>comprobantes-it</artifactId>
  <name>Comprobantes SRI :: Integración</name>
  <description>Pruebas que recorren modelo, firma y cliente juntos contra el ambiente de certificación del SRI. No se publica.</description>

  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
    <maven.install.skip>true</maven.install.skip>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.sonatype.central</groupId>
        <artifactId>central-publishing-maven-plugin</artifactId>
        <configuration>
          <skipPublishing>true</skipPublishing>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <dependencies>
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.peluware.sri</groupId>
      <artifactId>comprobantes-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.peluware.sri</groupId>
      <artifactId>comprobantes-core</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.peluware.sri</groupId>
      <artifactId>comprobantes-xades</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.peluware.sri</groupId>
      <artifactId>comprobantes-client</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
